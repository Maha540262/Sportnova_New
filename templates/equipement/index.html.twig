{% extends 'base.html.twig' %}

{% block title %}Sportnova - Équipements{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
            <h2 class="mb-0"><i class="bi bi-trophy"></i> Liste des Équipements</h2>
            <a class="btn btn-primary" href="{{ path('app_equipement_new') }}">
                <i class="bi bi-plus-circle"></i> Nouvel Équipement
            </a>
        </div>

        {% if app.session.flashbag.has('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ app.session.flashbag.get('success')[0] }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Description</th>
                                <th>État</th>
                                <th>Actions</th>
                                <th>Disponible</th>
<th>Image</th>

                            </tr>
                        </thead>
                        <tbody>
                            {% for equipement in equipements %}
                                <tr>
                                    <td>{{ equipement.id }}</td>
                                    <td><strong>{{ equipement.nom }}</strong></td>
                                    <td>{{ equipement.description }}</td>
                                    <td>
                                        <span class="badge rounded-pill bg-{{ equipement.etat|status_color }}">
                                            {{ equipement.etat|status_format }}
                                        </span>
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary me-1" href="{{ path('app_equipement_edit', {'id': equipement.id}) }}"><i class="bi bi-pencil"></i></a>
                                        <!-- Delete Button -->
                                        <form method="POST" action="{{ path('app_equipement_delete', {'id': equipement.id}) }}" style="display:inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr supprimer cet équipement ?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>
    {% if equipement.disponible %}
        <span class="badge bg-success">Oui</span>
    {% else %}
        <span class="badge bg-danger">Non</span>
    {% endif %}
</td>

<td>
    {% if equipement.imageUrl %}
        <img src="{{ equipement.imageUrl }}" alt="Image" style="max-height: 50px;">
    {% else %}
        <span class="text-muted">Pas d'image</span>
    {% endif %}
</td>

                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4">Aucun équipement</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        // Optional: You can add any JavaScript you need here
    </script>
{% endblock %}